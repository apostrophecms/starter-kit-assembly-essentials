{
  "name": "starter-kit-assembly-essentials",
  "version": "2.0.0",
  "description": "A boilerplate for multisite content-management in Apostrophe",
  "private": true,
  "scripts": {
    "build": "APOS_UPLOADFS_ASSETS=1 NODE_ENV=production bash -c 'node app @apostrophecms/asset:build --site=dashboard && ./scripts/for-each-theme @apostrophecms/asset:build'",
    "//": "because nodemon insists on executing 'start' if it exists, we must distinguish production",
    "production-start": "APOS_UPLOADFS_ASSETS=1 NODE_ENV=production npm run start",
    "start": "node app",
    "dev": "nodemon",
    "test": "eslint . && stylelint 'dashboard/**/*.scss' && stylelint 'sites/**/*.scss'",
    "e2e:dev": "CI=1 npm run dev",
    "e2e:serve": "NODE_ENV=production CI=1 bash -c 'node app @apostrophecms/asset:build --site=dashboard && ./scripts/for-each-theme @apostrophecms/asset:build && node app'",
    "e2e:test": "npm run e2e:dashboard && npm run e2e:default && npm run e2e:demo",
    "e2e:dashboard": "cypress run --config-file=cypress.dashboard.config.js",
    "e2e:default": "cypress run --config-file=cypress.site-default.config.js",
    "e2e:demo": "cypress run --config-file=cypress.site-demo.config.js",
    "cy:dashboard": "cypress open --config-file=cypress.dashboard.config.js",
    "cy:default": "cypress open --config-file=cypress.site-default.config.js",
    "cy:demo": "cypress open --config-file=cypress.site-demo.config.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apostrophecms/starter-kit-assembly-essentials"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Apostrophe Technologies",
  "license": "UNLICENSED",
  "dependencies": {
    "@apostrophecms-pro/document-versions": "^2.2.1",
    "@apostrophecms-pro/multisite": "^4.0.1",
    "@apostrophecms-pro/multisite-dashboard": "^1.0.1",
    "@apostrophecms-pro/palette": "^4.1.0",
    "@apostrophecms/favicon": "^1.1.1",
    "@opentelemetry/auto-instrumentations-node": "^0.46.1",
    "@opentelemetry/exporter-jaeger": "^1.24.1",
    "@opentelemetry/sdk-node": "^0.51.1",
    "@opentelemetry/semantic-conventions": "^1.24.1",
    "@tiptap/extension-text-style": "^2.4.0",
    "accordion-js": "^3.3.4",
    "apostrophe": "^4.5.2",
    "normalize.css": "^8.0.1",
    "require-all": "^3.0.0",
    "swiper": "^11.1.3"
  },
  "devDependencies": {
    "@apostrophecms-pro/cypress-tools": "^1.0.0-beta.16",
    "cypress": "^13.16.0",
    "eslint": "^8.0.0",
    "eslint-config-apostrophe": "^4.3.0",
    "eslint-plugin-cypress": "^2.15.2",
    "nodemon": "^3.1.1",
    "stylelint": "^16.6.1",
    "stylelint-config-apostrophe": "^4.0.0"
  }
}
